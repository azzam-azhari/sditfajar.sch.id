# SDIT Fajar - Template Environment Variables
# Salin menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.
# Jangan pernah memberi awalan NEXT_PUBLIC_ pada nilai rahasia.

# URL publik aplikasi (dipakai SEO/sitemap/canonical). Staging: URL Vercel staging. Produksi: domain resmi.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only secret. Hanya untuk Server Action/route server. JANGAN diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Opsional: verifikasi Google Search Console
GOOGLE_SITE_VERIFICATION=

# Payment gateway Midtrans DITUNDA (pembayaran memakai bukti transfer manual).
# Variabel di bawah belum dibaca kode; biarkan kosong sampai integrasi Midtrans dikerjakan.
# MIDTRANS_ENVIRONMENT=sandbox
# MIDTRANS_MERCHANT_ID=
# MIDTRANS_SERVER_KEY=
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Hanya lokal: akun uji untuk `npm run test:integration` (project Supabase dev, JANGAN produksi)
# TEST_MURID_QA_PASSWORD=
# TEST_WALI_QA_PASSWORD=
# TEST_SEED_PASSWORD=
